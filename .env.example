# FlameForge â€” esempio configurazione env (copia in .env.local)
# Vedi README.md "Variabili d'Ambiente" e docs/INTEGRATION.md per dettagli completi.
#
# Il prefisso canonico Ã¨ FLAMEFORGE_*. Le vecchie FLAMEFORGE_* restano accettate
# come fallback (con warning di deprecazione) per non rompere deploy esistenti.

# === Chiavi API (prioritÃ : header x-api-key > query api_key > fallback d'istanza) ===
# Fallback d'istanza opt-in per deploy personali single-user (NON usare su istanze pubbliche multi-utente):
# FLAMEFORGE_TMDB_KEY=your_tmdb_v3_key
# FLAMEFORGE_MDBLIST_KEY=your_mdblist_key
# FLAMEFORGE_TVDB_API_KEY=your_tvdb_key
# FLAMEFORGE_FANART_KEY=your_fanart_project_key   # poster verticali Fanart.tv (sezione editor); senza, la sezione spiega che non Ã¨ configurato

# === Trakt (liste pubbliche + OAuth PKCE per watchlist/liste standard private, multi-user) ===
# FLAMEFORGE_TRAKT_CLIENT_ID=your_trakt_client_id   # liste pubbliche come cataloghi custom (solo lettura, niente OAuth) + OAuth PKCE (stesso app: niente secret)
# NESSUN client secret: le app Trakt nuove usano PKCE ("Client Secret Not issued") â€” non impostare FLAMEFORGE_TRAKT_CLIENT_SECRET (se presente viene ignorato).
# Se hai copiato questa riga da una versione precedente, rimuovila:
# ~~FLAMEFORGE_TRAKT_CLIENT_SECRET=your_trakt_client_secret~~   # RIMOSSO: PKCE non usa secret (inviarlo romperebbe il sign-in)
# FLAMEFORGE_TRAKT_REDIRECT_URI=https://your-instance/api/trakt/callback   # URI esatta registrata nella dashboard dell'app Trakt (path sempre /api/trakt/callback, SOLO https)
# Test locali via tunnel HTTPS che serve l'intera origine UI (es. https://<tuo-sottodominio>.duckdns.org/api/trakt/callback): niente http://localhost â€” Trakt richiede redirect https.

# === Storage ===
# Redis nativo (TCP) per HA multi-replica senza /data â€” vince su KV_REST_* se entrambi settati:
# FLAMEFORGE_REDIS_URL=redis://:password@redis-master:6379/0
# (su ElfHosted/K8s basta REDIS_URL: Ã¨ letto come fallback nudo)
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx
# FLAMEFORGE_KV_CACHE=0   # cache risposte solo in memoria, stato sempre su KV (istanze pubbliche; sconsigliato su serverless)
# FLAMEFORGE_DATA_DIR=/data

# === Render pipeline ===
# FLAMEFORGE_MAX_CONCURRENT_RENDERS=4
# FLAMEFORGE_RENDER_SLOT_WAIT_MS=15000
# FLAMEFORGE_RENDER_TIMEOUT_MS=30000
# FLAMEFORGE_CACHE_MAX_MB=150
# FLAMEFORGE_CACHE_MAX=2000

# === Auth & rate limit ===
# FLAMEFORGE_PUBLIC_INSTANCE=1   # =1: route admin aperte senza token (LAN fidata/demo). Su istanze esposte lascia 0 + token qui sotto
# FLAMEFORGE_ADMIN_TOKEN=supersegreto   # istanze private: incollalo in Impostazioni â†’ Token admin (solo sessione) per usare warmup/cache/save dalla UI
# FLAMEFORGE_ALLOW_DEV_ADMIN=1   # solo in dev: apre admin ovunque (default: solo loopback)
# FLAMEFORGE_WARMUP_TOKEN=warmup-segreto
# FLAMEFORGE_RATELIMIT_POSTER_MAX=200
# FLAMEFORGE_LOG_LEVEL=info
# FLAMEFORGE_LOG_FORMAT=human
# FLAMEFORGE_TRUST_PROXY=1
# FLAMEFORGE_CLIENT_IP_HEADER=cf-connecting-ip   # con TRUST_PROXY=1: IP client SOLO da questo header (valore singolo sovrascritto dal proxy, non X-Forwarded-For)
# FLAMEFORGE_ALLOWED_HOSTS=example.com

# === Config token & profili ===
# FLAMEFORGE_MULTI_USER=1   # home = gate profili stile AIO (crea/seleziona spazio UUID); il primo spazio eredita mapping+default globali
# FLAMEFORGE_MAX_USERS=500   # cap anti-Sybil sul numero di spazi (0 o assente = illimitati)
# FLAMEFORGE_PUBLIC_STATS=0   # conteggi utenti di /api/status solo per admin (default: pubblici)
# FLAMEFORGE_MAX_MAPPINGS_PER_USER=500   # quota poster personalizzati per spazio (default: 500)
# CONFIG_HMAC_SECRET=segreto-firma-token   # senza, i ?config= non sono firmati (fail-closed in prod)
# PROFILE_ENCRYPTION_KEY=chiave-32-byte-hex   # senza, le chiavi profilo restano in chiaro (warning in prod)

# === Region & warmup ===
# FLAMEFORGE_REGION=IT
# FLAMEFORGE_SELF_WARMUP=1

# === Sponsor / hosting pubblico ===
# FLAMEFORGE_HOSTED_BY=elfhosted   # mostra il banner sponsor (solo "elfhosted" attivo, vuoto = nessun banner)

# === Custom Rating Provider ===
# Endpoint e header anche dall'editor (vince sull'env); la chiave SOLO env.
# FLAMEFORGE_CUSTOM_RATING_ENABLED=1
# FLAMEFORGE_CUSTOM_RATING_ENDPOINT=https://example.com/ratings/{imdbId}
# FLAMEFORGE_CUSTOM_RATING_API_KEY=segreto-provider
# FLAMEFORGE_CUSTOM_RATING_API_KEY_HEADER=X-API-Key
# FLAMEFORGE_CUSTOM_RATINGS=1   # default display riga (overridabile per-titolo)

# === Docker (solo compose) ===
# FLAMEFORGE_BIND_IP=127.0.0.1   # bind host (default 0.0.0.0)
# FLAMEFORGE_HOST_PORT=8080      # porta host (interna resta 8080)

# === Sharp & build ===
# SHARP_CONCURRENCY=2
# SHARP_CACHE_MEMORY_MB=64
# NODE_MAX_OLD_SPACE=384

